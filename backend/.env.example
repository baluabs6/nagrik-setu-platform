# This is an .env.example — every value below is a placeholder. Copy this
# file to `.env` and replace each ******* with a real, unique secret from
# Vault/your secrets manager. NEVER commit a real .env file.

# Django
DJANGO_SECRET_KEY=*******
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000

# Postgres
POSTGRES_DB=nagrik_setu
POSTGRES_USER=nagrik_setu
POSTGRES_PASSWORD=*******
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# HashiCorp Vault
VAULT_ADDR=http://vault:8200
VAULT_ROLE_ID=*******
VAULT_SECRET_ID=*******
VAULT_SECRETS_PATH=secret/data/nagrik-setu

# AWS
AWS_REGION=ap-south-1
AWS_S3_BUCKET=nagrik-setu-uploads
AWS_DYNAMODB_TABLE=nagrik-setu-events

# Azure DR
AZURE_DR_ENABLED=False

# Internal service-to-service auth (upload-validation Lambda callback —
# see core/internal_views.py)
INTERNAL_SERVICE_TOKEN=*******

# Agentic AI auto-triage (see core/ai_triage.py) — leave ENABLE_AI_TRIAGE
# false unless you've reviewed the data-handling implications of sending
# citizen-submitted text to a third-party LLM API.
ENABLE_AI_TRIAGE=False
ANTHROPIC_API_KEY=*******
REQUIRE_ATTACHMENT_VERIFICATION=False
